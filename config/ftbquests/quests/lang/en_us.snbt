	file.0000000000000001.title: "Cozy Critters"
	quest.0241AD5A93EDC04B.quest_desc: ["The &6Encased Fan&r can be used for a variety of things, such as &cBulk Smelting&r, &cColoring&r and much more!"]
	quest.08C4F0461A826F76.quest_desc: [
		"Framed Blocks is a very nice mod for building and allows you to turn pretty much all blocks into slabs, stairs etc."
		""
		"The &6Framed Cube&r and the &6Framing Saw&r are the core parts to this."
	]
	quest.08C4F0461A826F76.title: "Framed Blocks"
	quest.0AEA5CA57AF6ECAB.quest_desc: [
		"The beginning of your farming life starts with a home and of course your trusty hoe."
		""
		"&2Crops&r grow faster during the rain."
		""
		"You can also right-click to harvest!"
	]
	quest.0AEA5CA57AF6ECAB.title: "Farming Life Begins"
	quest.0E2AE23521A8364E.quest_desc: ["It's not Minecraft without chopping down your first tree!"]
	quest.0E2AE23521A8364E.title: "Gather Wood"
	quest.0EB62FAFB509BAFD.quest_desc: [
		"Ever got tired of placing down your crafting table? Fear no more!"
		""
		"With the &7Crafting Table on a Stick&r, you can simply right click it or even keybind it!"
	]
	quest.10F93CDCE1BB028F.quest_desc: [
		"An easy way to get a lot of those common stones."
		""
		"Obsidian and Stone require heating to be produced."
		""
		""
		"&6Create: Dragons Plus&r offers concrete farming."
	]
	quest.10F93CDCE1BB028F.title: "Create: Generators"
	quest.11CD9B18235D1D02.title: "Macaw's Furniture"
	quest.13473D175768CEB7.title: "Macaw's Stairs and Balconies"
	quest.16432248CA60070F.quest_desc: [
		"Well, you've made the portal.. Now you gotta go through."
		""
		"&eThe Ather&r has a bunch of advancements to help guide you through it, you can view them with the \"L\" keybind."
	]
	quest.16432248CA60070F.title: "Visit The Aether"
	quest.19538075FDF866CE.title: "Macaw's Windows"
	quest.1956BA33D413F3EB.quest_desc: ["&lSophisticated Storage&r has a lot of upgraded versions of the vanilla Chests, Barrels and Shulkers."]
	quest.1956BA33D413F3EB.title: "Sophisticated Storage"
	quest.1E128D9080CD5310.quest_desc: [
		"Bounty Boards can be found in villages or even crafted!"
		""
		"With these, you can choose limited-time bounties to collect and receive a reward."
	]
	quest.214D1B15430ADCA2.title: "Macaw's Doors"
	quest.266E04FF005A357D.quest_desc: [
		"&6Rechiseled&r and &6Chipped&r allow you to change a lot of blocks into some new variants."
		""
		"Due to an addon, the Rechiseled Chisel can be used for Chipped too!"
	]
	quest.2994B815B659FA44.title: "Buzzier Bees"
	quest.2A2FCF2BE230485E.title: "Macaw's Trapdoors"
	quest.2DB282B54FC3E837.quest_desc: [
		"Andesite Alloy is a primary crafting ingredient in &6Create,&r and the main reason you collected that andesite in the first place."
		""
		"You can make it with just 2 andesite and either 2 Iron Nuggets or 2 Zinc Nuggets. In the future you'll only need 1 of each!"
	]
	quest.2E0988955DF29048.title: "Chisels"
	quest.2E714AA39B073EA3.quest_desc: [
		"The &cArtifacts&r mod adds a lot of new items you can discover while looting."
		""
		"The &7Everlasting Beef/Eternal Steak&r have been disabled to encourage the farming aspect of the pack more."
	]
	quest.2FC3080B46F3B40D.title: "Macaw's Lights"
	quest.319BB08C3FA0C59E.quest_desc: [
		"&aSerene Seasons&r adds... you guessed it: seasons."
		""
		"&aSeasons&r decide what grows, when rain turns to snow, and how long you have until harvest."
		""
		"Using the Calendar you can view the current season."
	]
	quest.319BB08C3FA0C59E.title: "Serene Seasons"
	quest.3748C15DF5748199.quest_desc: [
		"&aConstruction Sticks&r are an easy way to place a lot of the same block."
		""
		"Depending on your tier, it can vary from 3 blocks, all the way up to 1028 blocks."
	]
	quest.3748C15DF5748199.title: "Construction Sticks"
	quest.39C3729722D0E468.quest_desc: [
		"With your new tools you can use &lFTB-Ultimine&r (Defaulted to your GRAVE key, usually between Esc and Tab) to mine up to 16 blocks."
		""
		"This also includes till-ing dirt, or even harvesting crops!"
	]
	quest.39C3729722D0E468.title: "The Stone Age"
	quest.41CE401FDD2474F7.quest_desc: [""]
	quest.41CE401FDD2474F7.title: "Handcrafted"
	quest.451D7EBA68E43196.quest_desc: ["Barrels are a variant of chests, while having the same slots as a single chest."]
	quest.46935628D94C993F.quest_desc: ["The vanilla chest is limited to just 27 slots, allowing the creation of a double chest."]
	quest.46935628D94C993F.title: "Chests"
	quest.47E2D16AC726ED4E.quest_desc: [
		"&7Botany Pots&r is a simple mod, allowing you to have a plot of farmland in a block."
		""
		"The base version requires you to manually harvest."
		""
		"The hopper version allows automatic harvesting."
		""
		"Andd the waxed version will simply show the crop in its fully grown state, without being farmable."
	]
	quest.47E2D16AC726ED4E.title: "Botany Pots"
	quest.4C194BA068DC71C6.quest_desc: [
		"&lThis is purely for the Beta while things get sorted into their normal spots.&r"
		""
		"Likely some &3Quest Chapters&r will become locked behind requirements, eg requiring visiting &cThe Nether&r to view &eThe Aether&r quests"
	]
	quest.4C956F8F630A8BDA.quest_desc: ["Large-mass storage of specific items"]
	quest.4C956F8F630A8BDA.title: "Functional Storage"
	quest.52F50AAC2896AAE5.quest_desc: ["The &6Feeding Trough&r can be used to have animals feed themselves, and eventually breeding."]
	quest.53871935A5E9783D.quest_desc: [
		"Get your trusty &6Wrench&r and &6Goggles!&r. I'll even refund the gold."
		""
		"&6Wrench&r can be used to pick-up &6Create&r blocks or to change the state (and even rotation!) of &6Create&r related things."
		""
		"The &6Engineer's Goggles&r when equipped will show you useful information about your &6Create&r machines"
	]
	quest.53871935A5E9783D.title: "Engineer's Degree"
	quest.54E2D9A3CF954AA1.quest_desc: ["Although not from Macaw's, you have the ability to jump directly over your fences."]
	quest.54E2D9A3CF954AA1.title: "Macaw's Fences and Walls"
	quest.55A8E33B059F2849.title: "Fairy Lights"
	quest.56E0655BE9A97C2C.quest_desc: [
		"To enter &eThe Aether&r you'll need glowstone and a water bucket."
		""
		"{image:cozycritters:textures/quests/aether/aether_portal.png width:100 height:100 align:center click_action:none:}"
	]
	quest.56E0655BE9A97C2C.title: "Preparations for The Aether"
	quest.5A6455404A24EE65.quest_desc: [
		"The Saw works like the stone cutter, but for wooden items instead!"
		""
		"If it's craftable with just wood, you can use the Saw for it."
	]
	quest.5A6455404A24EE65.title: "Wooden Stonecutter"
	quest.5EDA559F51E519F5.quest_desc: [
		"You'll want to convert some &#B36E03Logs&r into Andesite Casings. You can do this by stripping some logs and right-clicking them with your Andesite Alloy."
		""
		"This will be used for making your machines."
	]
	quest.617AB58B5946F488.quest_desc: [
		"You've probably heard of &6Create&r by now, with how popular its been for the past few years."
		""
		"It's a controversial, possibly even over-saturated mod... and yes it's in this pack too. "
		""
		"It's primarily in the pack due to how stunning the visuals are... especially the moving parts. Did I mention the Elevators?"
		""
		"Andddd it's been integrated with some extra stuff like easy cobblestone and a lot of other things!"
		""
		"{@pagebreak}"
		"Anyway, with all that being said... Get yourself lots of andesite to begin your &6Create&r journey."
	]
	quest.638FA04380A74215.title: "Macaw's Bridges"
	quest.69237D1E88EC307D.quest_desc: ["You're gonna want to smell all those metals you find."]
	quest.6CCF2F8D9A1FE585.quest_desc: [
		"&6Spice of Life&r rewards you with hearts when you eat a variety of foods. "
		"This goes up to &c+10 hearts&r at 50 foods eaten."
		""
		"The &6Food Book&r lets you see all the foods and whether you've eaten them so far."
	]
	quest.7019328FE555F310.quest_desc: [
		"Ever wanted Boobs? No? Oh well."
		""
		"You'll need to change your keybind for it (Search \"Female\" in your keybinds!) and then you can change that."
	]
	quest.71F56D82024CCC5F.title: "Artifacts"
	quest.73A8EDC909FAC340.quest_desc: ["Allows you to use more paintings and even custom ones!"]
	quest.73A8EDC909FAC340.title: "Immersive Paintings"
	quest.73CC61A9F5298076.title: "The Metal Age"
	quest.76A814D87B2343D5.quest_desc: [
		"Tom's Simple Storage "
		"Using the &lInventory Connector&r connected to your storages (eg Chests!) and a &lStorage Terminal&r to access it."
		"{@pagebreak}"
		"[ \"You can use \", { \"text\": \"this video\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://youtu.be/nW5ElcWiC3c\" } }, \" as a guide\" ]"
	]
	quest.76A814D87B2343D5.title: "Tom's Simple Storage"
	quest.7B61B6507F820511.quest_desc: [
		"Ever needed more storage on your player? Well need no more!"
		""
		"With &lSophisticated Backpacks&r you can have an upgradable backpack that you can also wear in your curios slot."
	]
	quest.7B61B6507F820511.title: "Sophisticated Backpacks"
